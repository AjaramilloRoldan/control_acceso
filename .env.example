# Configuración de Base de Datos
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=control_acceso

# Flask Secret Key (generar con: python -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=your_secret_key_here


# Entorno (development/production)
FLASK_ENV=development
FLASK_DEBUG=True

# Correo para notificaciones (opcional; sin SMTP_HOST solo se usa la bandeja de la plataforma)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Producción detrás de Nginx: cookies solo por HTTPS e IP real del cliente
BEHIND_HTTPS_PROXY=False

# Reglas de acceso y reservas, en minutos
MARGEN_ACCESO_MINUTOS=10
PLAZO_MODIFICACION_MINUTOS=60

# Respaldos (python respaldar_base.py)
BACKUP_DIR=
BACKUP_RETENTION_DAYS=30
MYSQLDUMP_PATH=mysqldump
